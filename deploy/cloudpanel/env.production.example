# XarxesGest — production .env for CloudPanel (xarxesgest.soportic.es)
# Copy to the site root as .env, fill the blanks, then: php8.4 artisan key:generate
# Full list of options: .env.example

APP_NAME="XarxesGest"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://xarxesgest.soportic.es
APP_LOCALE=ca
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# CloudPanel's Nginx runs on the same host
TRUSTED_PROXIES=127.0.0.1

# Self-hosted: no billing, registration by invite only
SELF_HOSTED=true
CHANGELOG_ENABLED=false
# true = links in X posts are rewritten as non-clickable (example(.)com) to avoid
# X's link-post rate (~0.20 $/post vs ~0.015 $). Decide per your X budget.
X_DEFUSE_LINKS=false

# Legal pages linked from the app (Meta and LinkedIn require a privacy policy)
LEGAL_PRIVACY_URL=https://soportic.es/politica-de-privacitat
LEGAL_TERMS_URL=https://soportic.es/avis-legal

LOG_CHANNEL=daily
LOG_LEVEL=warning

# MySQL 8.4 created from CloudPanel → Databases
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=xarxesgest
DB_USERNAME=xarxesgest
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Media stored on the VPS (served publicly — Instagram needs public URLs)
FILESYSTEM_DISK=local

# Mail (notifications: post published / failed, invites)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="xarxesgest@soportic.es"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb: server listens on 127.0.0.1:8080; browsers connect through Nginx (wss, 443)
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=xarxesgest.soportic.es
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Passport keys (API / MCP). Generate once: php8.4 artisan passport:keys --show
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# ---- Social networks -------------------------------------------------------
# LinkedIn — https://developer.linkedin.com (products: Sign In with LinkedIn
# using OpenID Connect, Share on LinkedIn; Community Management API for pages)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CLIENT_REDIRECT="${APP_URL}/accounts/linkedin/callback"
# Same LinkedIn app for profile and company pages; pages need the Community
# Management API approved on that app (scopes w_organization_social, ...).

# X — https://developer.x.com (OAuth 2.0, type "Web App", pay-per-use credits)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CLIENT_REDIRECT="${APP_URL}/accounts/x/callback"

# Instagram (Instagram API with Instagram Login) — https://developers.facebook.com
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CLIENT_REDIRECT="${APP_URL}/accounts/instagram/callback"

# ---- AI --------------------------------------------------------------------
AI_TEXT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-opus-5-5
# OpenAI: image generation (next phase)
OPENAI_API_KEY=

# ---- Telemetry off ---------------------------------------------------------
POSTHOG_ENABLED=false
NIGHTWATCH_ENABLED=false
TELESCOPE_ENABLED=false
