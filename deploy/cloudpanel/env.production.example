# SocialGest (XarxesGest) — production .env for CloudPanel (socialgest.soportic.es)
# Copy to the site root as .env, fill the blanks, then: php8.4 artisan key:generate
# After any change: php8.4 artisan optimize && php8.4 artisan horizon:terminate
# Full list of options: .env.example

APP_NAME="SocialGest"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://socialgest.soportic.es
APP_LOCALE=ca
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

# CloudPanel's Nginx runs on the same host
TRUSTED_PROXIES=127.0.0.1

# Self-hosted: no billing, registration by invite only
SELF_HOSTED=true
CHANGELOG_ENABLED=false
# true = links in X posts are rewritten as non-clickable (example(.)com) to avoid
# X's link-post rate (~0.20 $/post vs ~0.015 $). Decide per your X budget.
X_DEFUSE_LINKS=false

# Legal pages linked from the app (Meta and LinkedIn require a privacy policy)
LEGAL_PRIVACY_URL=https://soportic.es/politica-de-privacitat
LEGAL_TERMS_URL=https://soportic.es/avis-legal

LOG_CHANNEL=daily
LOG_LEVEL=warning

# Database created from CloudPanel → Databases.
# CloudPanel installs MariaDB (10.11 on Ubuntu 24.04): use the mariadb driver.
# With MySQL 8 use DB_CONNECTION=mysql.
DB_CONNECTION=mariadb
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=socialgest
DB_USERNAME=socialgest
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=reverb
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Redis may be shared with other sites on the server: own databases and prefix
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=4
REDIS_CACHE_DB=5
REDIS_PREFIX=socialgest-

# Media on the VPS. Must be "public": files go to storage/app/public and Nginx
# serves them at /storage (Instagram needs public URLs). "local" is a private
# disk and every avatar and image shows broken.
FILESYSTEM_DISK=public

# Mail (notifications, invites, password resets). Laravel 13 reads MAIL_SCHEME,
# not MAIL_ENCRYPTION: leave it empty for port 587 (STARTTLS), smtps for 465.
# MAIL_FROM_ADDRESS must be a sender the SMTP account may use.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="socialgest@soportic.es"
MAIL_FROM_NAME="${APP_NAME}"

# Reverb. CloudPanel's Laravel vhost already uses port 8080 internally, so the
# Reverb server listens on 127.0.0.1:8090 (supervisor + Nginx snippet agree).
# Browsers connect through Nginx on 443 (wss).
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_SERVER_HOST=127.0.0.1
REVERB_SERVER_PORT=8090
REVERB_HOST=127.0.0.1
REVERB_PORT=8090
REVERB_SCHEME=http
VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST=socialgest.soportic.es
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

# Queue dashboard (/horizon): comma-separated emails allowed to open it
HORIZON_ALLOWED_EMAILS=

# Passport keys (API / MCP). Leave empty: `php8.4 artisan passport:keys` writes
# storage/oauth-*.key, which Passport reads when these are empty and deploys
# never touch.
PASSPORT_PRIVATE_KEY=
PASSPORT_PUBLIC_KEY=

# ---- Social networks -------------------------------------------------------
# LinkedIn — https://www.linkedin.com/developers/apps
# Personal profile: an app with "Sign In with LinkedIn using OpenID Connect"
# and "Share on LinkedIn". LinkedIn requires the Community Management API
# (company pages) to be the only product of its app, and TryPost uses one app
# for both: keep company pages off until that is handled.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CLIENT_REDIRECT="${APP_URL}/accounts/linkedin/callback"
LINKEDIN_PAGE_ENABLED=false

# X — https://developer.x.com (OAuth 2.0 Client ID/Secret, "Web App", Read and
# write, pay-per-use credits with a monthly spend cap)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_CLIENT_REDIRECT="${APP_URL}/accounts/x/callback"

# Instagram (API setup with Instagram login) — https://developers.facebook.com
# Use the Instagram app ID/secret of that page, not App settings → Basic.
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_CLIENT_REDIRECT="${APP_URL}/accounts/instagram/callback"

# Networks not used by Soportic: hidden from "Connect channels"
TIKTOK_ENABLED=false
YOUTUBE_ENABLED=false
FACEBOOK_ENABLED=false
INSTAGRAM_FACEBOOK_ENABLED=false
THREADS_ENABLED=false
PINTEREST_ENABLED=false
BLUESKY_ENABLED=false
MASTODON_ENABLED=false
TELEGRAM_ENABLED=false
DISCORD_ENABLED=false
GOOGLE_BUSINESS_ENABLED=false

# ---- AI --------------------------------------------------------------------
AI_TEXT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_TEXT_MODEL=claude-opus-5-5
# OpenAI: image generation
OPENAI_API_KEY=

# ---- Telemetry off ---------------------------------------------------------
POSTHOG_ENABLED=false
NIGHTWATCH_ENABLED=false
TELESCOPE_ENABLED=false
